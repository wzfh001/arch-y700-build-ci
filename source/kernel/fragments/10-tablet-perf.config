# TB321FU 平板交互性能 fragment（单变量组：内核节拍 + 抢占动态化）
# 基准：vendor 基线（HZ=250，PREEMPT=y 静态）
# 目标：KDE 触控/滚动手感更跟手；代价：节拍 1000 功耗略升
# 依据：ALARM linux-aarch64 通用 config（7.1.x）采用 HZ=1000 + PREEMPT_DYNAMIC=y
# 注意：HZ 内部 choice 符号必须一并写（HZ_1000=y / HZ_250 not set），否则 olddefconfig 可能回退
# 状态：候选（未上机）；K9 纪律：单组变量、独立 EXP、可回滚基线单元
CONFIG_HZ_1000=y
# CONFIG_HZ_250 is not set
CONFIG_HZ=1000
CONFIG_PREEMPT_DYNAMIC=y
