# TB321FU 内存兜底 fragment：zram/zswap 压缩 swap + PSI 压力预警
# 基准：vendor 基线（无 ZRAM/ZSWAP/PSI；SWAP=y、CRYPTO_LZO=y 已具备依赖）
# 目标：16G RAM 平板在 KDE/浏览器压力下不被 OOM 杀死；earlyoom/systemd-oomd 可读 /proc/pressure
# 依据：ALARM linux-aarch64 通用 config（ZRAM=m + LZO backend + ZSWAP + PSI）
# 状态：候选（未上机）；安装后需配套 /etc/systemd/zram-generator 配置（默认 off）
# 注意：ZRAM 用 LZO backend（baseline 已含 CRYPTO_LZO=y）；DEF_COMP lzo-rle 与 ALARM 一致
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y
CONFIG_ZRAM_DEF_COMP="lzo-rle"
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZO=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT="lzo"
CONFIG_PSI=y
