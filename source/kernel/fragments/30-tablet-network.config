# TB321FU 网络特性 fragment：WireGuard + nftables + cgroup CPU 带宽
# 基准：vendor 基线（无 WIREGUARD / NF_TABLES / CFS_BANDWIDTH）
# 目标：VPN/内网访问可用；消除 systemd nftables 服务因缺 NF_TABLES 的 failed 状态；
#       systemd 可用 cgroup CPU 限额（RunMaxCPU 等）
# 依据：ALARM linux-aarch64 通用 config
# 状态：候选（未上机）；依赖 NETFILTER 基础由 olddefconfig 按 =m 自动补齐
CONFIG_WIREGUARD=m
CONFIG_NF_TABLES=m
CONFIG_CFS_BANDWIDTH=y
