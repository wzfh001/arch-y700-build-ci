# TB321FU 内核加固 fragment（日用安全基线）
# 基准：vendor 基线（已有 STACKPROTECTOR=y/STRONG=y、RANDOMIZE_BASE=y、
#       RANDOMIZE_KSTACK_OFFSET=y、STRICT_KERNEL_RWX=y、STRICT_MODULE_RWX=y；
#       缺 slab/页分配随机化、init-on-alloc/free、FORTIFY、HARDENED_USERCOPY）
# 目标：缓解堆/页分配器利用（freelist 随机化）、清零敏感内存（init-on-alloc/free）、
#       字符串/拷贝越界检测（FORTIFY/HARDENED_USERCOPY）
# 依据：主流桌面发行版（Debian/Ubuntu/Arch）默认开启的加固子集；
#       与本设备已有 RANDOMIZE_BASE/KSTACK_OFFSET 互补，不冲突
# 状态：候选（未上机）；K9 纪律：单组变量、独立 EXP、可回滚基线单元
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
